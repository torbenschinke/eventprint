[Unit]
Description=eventprint: Systemkonfiguration an das Repository angleichen
Documentation=file:/opt/eventprint/README.md

# Nach dem Updater und vor dem Dienst.
#
# Die Reihenfolge ist wichtiger, als sie aussieht: provision.sh stammt aus dem
# Repository, und der Updater ist es, der das Repository aktualisiert. Liefe
# das Provisioning zuerst, arbeitete es mit dem Skript des VORHERIGEN Standes -
# eine Aenderung daran braeuchte dann zwei Neustarts, und der zweite wuerde
# vergessen. So genuegt einer.
#
# Der Updater endet immer mit Erfolg und behaelt im Zweifel den alten Stand,
# hier auf ihn zu warten kostet also nichts.
After=eventprint-update.service
Wants=eventprint-update.service
Before=eventprint.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Bewusst als root: Genau das ist der Zweck. update.sh laeuft unprivilegiert
# und kann nur Go-Code ausspielen; jede Aenderung an udev oder systemd hing
# vorher daran, dass jemand mit root vor dem Geraet sitzt. Beim ersten Einsatz
# bedeutete das eine Autofahrt, weil die Box im Gastnetz nicht erreichbar war.
#
# Der Preis ist benannt und angenommen: Wer auf den Zweig pushen kann, fuehrt
# hier Befehle als root aus.
ExecStart=/opt/eventprint/scripts/provision.sh

# Das Skript endet immer mit Erfolg. Diese Zeile ist der zweite Riegel: Ein
# Fehler hier darf die Fotobox nicht am Starten hindern.
SuccessExitStatus=0 1

TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
