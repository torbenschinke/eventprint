<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <!--
    Fenstersteuerung der Fotobox.

    Der Raspberry Pi 400 ist selbst eine Tastatur. Ein Gast hat sie also immer
    in der Hand, auch wenn er nur den Touchscreen bedienen soll. Deshalb steht
    hier bewusst KEINE einzige Tastenbindung: kein Alt+F4, kein Alt+Tab, kein
    Wechsel auf einen anderen Arbeitsplatz. Was nicht gebunden ist, kann auch
    nicht ausgeloest werden.

    Ebenso wenig Maus-Bindungen auf dem Hintergrund: Ein Rechtsklick auf den
    Desktop oeffnete sonst das Openbox-Menue mit einem Terminal-Eintrag.
  -->

  <theme>
    <name>Clearlooks</name>
    <!-- Keine Titelleiste: Es gibt genau ein Fenster, und es ist im Vollbild. -->
    <titleLayout></titleLayout>
    <keepBorder>no</keepBorder>
  </theme>

  <desktops>
    <!-- Genau ein Arbeitsplatz. Mehrere waeren nur eine weitere Moeglichkeit,
         das Fenster der Fotobox aus den Augen zu verlieren. -->
    <number>1</number>
    <names><name>Fotobox</name></names>
  </desktops>

  <applications>
    <application class="*">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
    </application>
  </applications>

  <keyboard>
  </keyboard>

  <mouse>
  </mouse>
</openbox_config>
